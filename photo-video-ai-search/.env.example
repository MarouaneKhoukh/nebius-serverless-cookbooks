# Managed HTTPS base URL; do not append /v1 or /embeddings.
EMBEDDING_BASE_URL=https://your-endpoint.tunnel.applications.region.nebius.cloud
# Set your Endpoint token here locally. Never commit or share .env.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
EMBEDDING_DIMENSIONS=4096
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=photo_video_qwen3vl8b_v1
QDRANT_API_KEY=
DATA_DIR=./data

# Required for the complete recipe: second managed URL on the SAME GPU Endpoint (port 8001).
GENERATION_BASE_URL=
GENERATION_API_KEY=
GENERATION_MODEL=black-forest-labs/flux-3-image-klein
# Similarity heuristic: calibrate using your own media. Not a confidence percentage.
MATCH_THRESHOLD=0.25
MAX_GENERATIONS_PER_DAY=20
SEARCH_REQUESTS_PER_HOUR=120
GENERATION_REQUESTS_PER_HOUR_PER_IP=3
PUBLIC_DEMO=false
# Optional browser sign-in; public Compose uses HTTPS before transmitting this.
DEMO_USERNAME=demo
DEMO_PASSWORD=
