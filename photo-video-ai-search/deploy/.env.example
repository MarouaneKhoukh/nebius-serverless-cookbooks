DOMAIN=gallery.your-domain.example
ACME_EMAIL=you@your-domain.example
EMBEDDING_BASE_URL=https://your-port8000-managed-host
EMBEDDING_API_KEY=
GENERATION_BASE_URL=https://your-port8001-managed-host
GENERATION_API_KEY=
# Use a new random secret, not the Endpoint token. This stays on the CPU host.
QDRANT_API_KEY=
MATCH_THRESHOLD=0.25
MAX_GENERATIONS_PER_DAY=20
SEARCH_REQUESTS_PER_HOUR=120
GENERATION_REQUESTS_PER_HOUR_PER_IP=3
# Optional browser password. Leave blank for anonymous visitors with the above caps.
DEMO_USERNAME=demo
DEMO_PASSWORD=
